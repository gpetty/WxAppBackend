# /etc/systemd/system/wxmonitor@.service
#
# Weather Window health monitor — systemd template unit.
# Instantiated as wxmonitor@nbm, wxmonitor@ndfd, wxmonitor@blend.
# Each instance checks one service and pings its own healthchecks.io UUID.
#
# Install:
#   sudo cp systemd/wxmonitor@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   (timers enable/start the service instances automatically)

[Unit]
Description=Weather Window health monitor — %i

[Service]
Type=oneshot
User=gpetty
WorkingDirectory=/home/gpetty/WxApp
ExecStart=/home/gpetty/WxApp/.venv/bin/python scripts/wxmonitor.py %i
StandardOutput=journal
StandardError=journal
