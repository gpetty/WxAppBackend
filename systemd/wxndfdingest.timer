# /etc/systemd/system/wxndfdingest.timer
#
# Weather Window NDFD Ingestion — hourly trigger
#
# NDFD updates asynchronously up to every 30 min per element.
# Hourly is sufficient for the forecast drift feature; reduce to 30 min
# by changing OnCalendar to *:0,30 if finer snapshot granularity is desired.
#
# Install: sudo cp systemd/wxndfdingest.timer /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now wxndfdingest.timer

[Unit]
Description=Weather Window NDFD Ingestion — hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=3min
Persistent=true

[Install]
WantedBy=timers.target
